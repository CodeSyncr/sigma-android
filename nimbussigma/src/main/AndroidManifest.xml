<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sheets open from Nimbus Cloud and save back to Sigma. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Shares exported sheets (.xlsx, .csv) with other apps. -->
        <provider
            android:name="space.nimbusgo.sigma.SigmaFileProvider"
            android:authorities="${applicationId}.nimbussigma.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/nimbussigma_file_paths" />
        </provider>
    </application>
</manifest>
